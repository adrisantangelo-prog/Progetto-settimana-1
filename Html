                <br>
                <input type="email" id="email" name="email" placeholder="tu@esempio.it" required>
                <br><br>
            </div>
            <div>
                <label for="message">Motivo del contatto</label>
                <br>
                <select name="Motivo del contatto" id="Motivodelcontatto">
